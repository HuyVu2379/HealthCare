server:
  port: 8087

spring:
  application:
    name: payment-service
  datasource:
    url: jdbc:postgresql://localhost:5433/paymentservicedb
    username: postgres
    password: postgres
    driver-class-name: org.postgresql.Driver
    hikari:
      maximum-pool-size: 10
      minimum-idle: 5
      connection-timeout: 30000
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
        format_sql: true
    database-platform: org.hibernate.dialect.PostgreSQLDialect


eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka
    fetch-registry: true
    register-with-eureka: true

payos:
  client-id: ${PAYOS_CLIENT_ID:your-client-id}
  api-key: ${PAYOS_API_KEY:your-api-key}
  checksum-key: ${PAYOS_CHECKSUM_KEY:your-checksum-key}

payment:
  expiry-minutes: 15
  webhook-url: ${WEBHOOK_URL:https://your-domain.ngrok-free.dev/api/v1/payments/webhook}
  webhook-auto-register: ${WEBHOOK_AUTO_REGISTER:false}
  return-url: ${FRONTEND_URL:http://localhost:3000}/payment/success
  cancel-url: ${FRONTEND_URL:http://localhost:3000}/payment/cancel

scheduling:
  service:
    name: ${SCHEDULING_SERVICE_NAME:scheduling-service}
    url: ${SCHEDULING_SERVICE_URL:http://localhost:8084}
    auth:
      user: ${SCHEDULING_SERVICE_AUTH_USER:payment-service}
      role: ${SCHEDULING_SERVICE_AUTH_ROLE:SYSTEM}
      user-id: ${SCHEDULING_SERVICE_AUTH_USER_ID:payment-service}
      token: ${SCHEDULING_SERVICE_AUTH_TOKEN:internal-service-token}

logging:
  level:
    fit.iut.student.paymentservice: DEBUG
    org.springframework.cloud.openfeign: DEBUG
    org.springframework.retry: DEBUG

